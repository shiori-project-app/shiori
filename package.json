{
  "name": "shiori",
  "version": "1.0.0",
  "private": true,
  "description": "Shiori — anime desktop app",
  "homepage": "https://github.com/shiori-project-app/shiori",
  "author": "shiori-anime",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vp dev\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test run",
    "start": "vp build && electron .",
    "dist": "vp build && electron-builder --publish never",
    "dist:linux": "vp build && electron-builder --linux --publish never",
    "dist:win": "vp build && electron-builder --win --publish never",
    "dist:arch": "vp build && electron-builder --linux pacman --x64 --publish never",
    "dist:debian": "vp build && electron-builder --linux deb --x64 --arm64 --publish never",
    "dist:fedora": "vp build && electron-builder --linux rpm --x64 --arm64 --publish never",
    "dist:appimage": "vp build && electron-builder --linux AppImage --x64 --arm64 --publish never",
    "dist:portable": "vp build && electron-builder --linux tar.gz --x64 --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "assjs": "^0.1.10",
    "concurrently": "^10.0.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sass": "^1.107.1",
    "vite-plus": "^1.4.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "@parcel/watcher@2.6.0": true
  },
  "build": {
    "appId": "com.shiori.app",
    "productName": "Shiori",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shiori",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "artifactName": "Shiori-Setup-${version}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "shiori",
      "icon": "build/icon.png",
      "category": "AudioVideo;Video",
      "synopsis": "Anime tracking and playback from your own download folder",
      "maintainer": "shiori-anime",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libcups2",
        "libasound2t64 | libasound2"
      ],
      "recommends": [
        "libappindicator3-1",
        "fonts-noto-cjk"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(mesa-libgbm or libgbm1)",
        "(cups-libs or libcups2)",
        "(alsa-lib or libasound2)"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "mesa",
        "libcups",
        "alsa-lib"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "shiori-project-app",
      "repo": "shiori"
    }
  },
  "desktopName": "shiori.desktop",
  "productName": "Shiori"
}
